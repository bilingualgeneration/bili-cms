{
  "kind": "collectionType",
  "collectionName": "intruders",
  "info": {
    "singularName": "intruder",
    "pluralName": "intruders",
    "displayName": "Intruder",
    "description": ""
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "uuid": {
      "type": "customField",
      "options": {
        "uuid-format": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
        "disable-regenerate": true
      },
      "customField": "plugin::strapi-advanced-uuid.uuid"
    },
    "handle": {
      "type": "string",
      "required": true,
      "unique": true
    },
    "cover_image": {
      "type": "media",
      "multiple": false,
      "required": true,
      "allowedTypes": [
        "images"
      ]
    },
    "pack_name": {
      "type": "component",
      "repeatable": true,
      "component": "common.multilingual-text"
    },
    "word_group": {
      "displayName": "word group",
      "type": "component",
      "repeatable": true,
      "component": "intruder.word-group",
      "required": true
    },
    "language": {
      "type": "enumeration",
      "enum": [
        "en",
        "es",
        "es-inc"
      ]
    }
  }
}
