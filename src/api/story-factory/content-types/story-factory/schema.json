{
  "kind": "collectionType",
  "collectionName": "story_factories",
  "info": {
    "singularName": "story-factory",
    "pluralName": "story-factories",
    "displayName": "Story Factory",
    "description": ""
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "handle": {
      "type": "string",
      "required": true,
      "unique": true
    },
    "pack_name": {
      "type": "component",
      "repeatable": true,
      "component": "common.multilingual-text"
    },
    "uuid": {
      "type": "customField",
      "options": {
        "uuid-format": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
        "disable-regenerate": true
      },
      "customField": "plugin::strapi-advanced-uuid.uuid"
    },
    "cover_image": {
      "allowedTypes": [
        "images"
      ],
      "type": "media",
      "multiple": false,
      "required": true
    },
    "level": {
      "type": "integer"
    },
    "word_group": {
      "displayName": "word group",
      "type": "component",
      "repeatable": true,
      "component": "story-factory.word-group"
    }
  }
}
