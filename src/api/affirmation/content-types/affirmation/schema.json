{
  "kind": "collectionType",
  "collectionName": "affirmations",
  "info": {
    "singularName": "affirmation",
    "pluralName": "affirmations",
    "displayName": "Affirmations",
    "description": ""
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "handle": {
      "type": "string",
      "required": true,
      "unique": true
    },
    "cover_image": {
      "type": "media",
      "multiple": false,
      "required": true,
      "allowedTypes": [
        "images"
      ]
    },
    "pack_name": {
      "displayName": "multilingual text",
      "type": "component",
      "repeatable": true,
      "component": "common.multilingual-text"
    },
    "cards": {
      "displayName": "affirmations_card",
      "type": "component",
      "repeatable": true,
      "component": "affirmations.affirmations-card"
    },
    "uuid": {
      "type": "customField",
      "options": {
        "disable-regenerate": true,
        "uuid-format": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
      },
      "customField": "plugin::strapi-advanced-uuid.uuid",
      "required": true
    }
  }
}
