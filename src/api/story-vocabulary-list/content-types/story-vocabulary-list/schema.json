{
  "kind": "collectionType",
  "collectionName": "story_vocabulary_lists",
  "info": {
    "singularName": "story-vocabulary-list",
    "pluralName": "story-vocabulary-lists",
    "displayName": "Story Vocabulary List",
    "description": ""
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "uuid": {
      "type": "customField",
      "options": {
        "uuid-format": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
        "disable-regenerate": true
      },
      "customField": "plugin::strapi-advanced-uuid.uuid"
    },
    "handle": {
      "type": "string",
      "required": true,
      "unique": false
    },
    "words": {
      "displayName": "word",
      "type": "component",
      "repeatable": true,
      "component": "story-vocabulary-list.word"
    },
    "story": {
      "type": "string"
    }
  }
}
